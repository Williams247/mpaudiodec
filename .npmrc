# =========================================================================
# ENGINE & INTEGRITY ENFORCEMENT
# =========================================================================

# Forces everyone on the team and CI/CD servers to use pnpm.
# If anyone tries running 'npm install' or 'yarn', the installation will fail immediately.
engine-strict=true

# Automatically validates downloaded packages against their cryptographic hashes.
# If a package's registry metadata or files are altered, pnpm blocks the install instantly.
integrity=true

# =========================================================================
# PEER DEPENDENCY ARCHITECTURE (Critical for React 19 Ecosystem)
# =========================================================================

# Automatically looks up and downloads missing peer dependencies.
# This prevents manual install headaches with Radix UI components and companion libraries.
auto-install-peers=true

# Causes installations to fail if sub-packages have mismatched peer versions.
# This acts as an early warning system against accidental layout crashes or incompatibilities.
strict-peer-dependencies=true

# =========================================================================
# MONOREPO ISOLATION & LOGGING
# =========================================================================

# Prevents dependencies from dropping unlisted "phantom" packages into node_modules.
# Your code can strictly only import modules that you explicitly declared in package.json.
shamefully-hoist=false

# Mutes unnecessary installation chatter and warning flags in the terminal.
# It ensures that only actual, actionable build errors are printed to your screen.
loglevel=error
